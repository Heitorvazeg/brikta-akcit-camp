# Copie para .env e preencha. Detalhes: docs/PLANO_DE_IMPLEMENTACAO.md, Seção 12.4
AMBIENTE=local
LOG_NIVEL=INFO

# Banco do serviço de IA (usado a partir da IA-F3)
DATABASE_URL=postgresql+asyncpg://brikta_ia:brikta_ia@localhost:5432/brikta_ia

# Segurança entre serviços
# Tokens aceitos do backend (separados por vírgula; o segundo serve para rotação)
IA_SERVICE_TOKENS=troque-este-token-local
IA_CALLBACK_SECRET=troque-este-segredo-local
BACKEND_BASE_URL=http://localhost:3000/api/v1
# Passe do Assistente: o MESMO valor do IA_TICKET_SECRET do backend (`npm run segredos:local` na
# raiz gera e copia). Vazio ou fraco: a IA sobe e o Assistente recusa tudo (aviso no log).
IA_TICKET_SECRET=
STORAGE_HOSTS_PERMITIDOS=localhost

# Provedores (nomes de modelo SEMPRE por configuração, nunca no código)
STT_PROVEDOR=fake
STT_PROVEDOR_SECUNDARIO=
STT_MODELO=
LLM_EXTRACAO_PROVEDOR=fake
LLM_EXTRACAO_MODELO=

# Assistente (protótipo): Groq ou outro provedor compatível com a API da OpenAI.
# fake = respostas fixas, sem rede. Para o Groq: openai_compativel + chave do console.groq.com
LLM_ASSISTENTE_PROVEDOR=fake
LLM_ASSISTENTE_MODELO=openai/gpt-oss-120b
LLM_ASSISTENTE_BASE_URL=https://api.groq.com/openai/v1
LLM_ASSISTENTE_API_KEY=
# mock = dados de exemplo (gerados do seed da demonstração do backend)
ASSISTENTE_FERRAMENTAS=mock
# Ferramentas simuladas além dos RDOs (documentos, bim, mcp); vazio desliga todas
ASSISTENTE_FERRAMENTAS_EXTRAS=documentos,bim,mcp
# laco_proprio = agente do protótipo, até a IA-64a escolher o framework
ASSISTENTE_AGENTE=laco_proprio
ASSISTENTE_MAX_PASSOS=4
# "Hoje" fixo. Os dados de exemplo foram gerados do seed em 2026-10-20 (hoje_demonstracao em dados.json);
# com o seed rodado hoje, deixe vazio (= data de hoje).
ASSISTENTE_DATA_REFERENCIA=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=

# Limites
AUDIO_MAX_SEG=600
AUDIO_MAX_BYTES=26214400
LIMITE_AUDIOS_EMPRESA_DIA=50
ORCAMENTO_EMPRESA_MES_USD=5

# Observabilidade (IA-F4)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
